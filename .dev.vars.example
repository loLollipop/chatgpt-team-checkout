# 复制为 .dev.vars，仅供 wrangler dev 使用。不要提交真实密钥。
RELAY_CONFIG='{"url":"http://127.0.0.1:8790/forward","token":"replace-with-relay-token"}'
PROXY_ENCRYPTION_KEY=replace-with-a-stable-long-random-encryption-key
# 旧版按国家 Relay 配置仍可作为回退；新部署保持空对象即可。
COUNTRY_PROXY_CONFIG='{}'
ALLOW_DIRECT_CHECKOUT=false
ADMIN_TOKEN=replace-with-a-long-random-admin-token
CDK_HASH_PEPPER=replace-with-another-long-random-secret
