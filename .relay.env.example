# 复制为 .relay.env，仅供 npm run relay:dev 使用。不要提交真实密钥。
PORT=8790
RELAY_TOKEN=replace-with-a-long-random-token
COUNTRY_UPSTREAM_PROXIES='{"US":"http://user:password@us-proxy.example.com:8080","EG":"http://user:password@eg-proxy.example.com:8080","GB":"http://user:password@gb-proxy.example.com:8080","PH":"http://user:password@ph-proxy.example.com:8080","JP":"http://user:password@jp-proxy.example.com:8080","TH":"http://user:password@th-proxy.example.com:8080","IN":"http://user:password@in-proxy.example.com:8080","SE":"http://user:password@se-proxy.example.com:8080"}'
